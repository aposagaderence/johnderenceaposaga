---
import "../styles/global.css";
---

<!-- HERO SECTION -->
<header class="hero-section text-center py-4">
  <div
    class="inline-block bg-orange-400 text-black border-2 border-black font-black p-1"
  >
    LET'S GET THIS PARTY STARTED
  </div>

  <h2 class="text-3xl font-extrabold text-orange-500 my-2">
    DERENCE EVENT ORGANIZER Party Planning & Decorating Services
  </h2>

  <img
    src="https://weezevent.com/wp-content/uploads/2019/01/12145054/organiser-soiree-1000x585.jpg"
    alt="Party Setup"
    class="w-full h-auto max-h-[350px] object-cover rounded-lg border-6 border-orange-400 my-4 shadow-sm"
  />

  <p class="text-center text-lg font-bold leading-relaxed uppercase">
    GOOD SERVICES | GREAT PRODUCTS | FUN ENVIRONMENT | NICE STAFF
  </p>
</header>
